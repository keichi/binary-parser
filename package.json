{
  "name": "binary-parser",
  "version": "2.3.0",
  "description": "Blazing-fast binary parser builder",
  "type": "module",
  "main": "dist/binary_parser.js",
  "types": "dist/binary_parser.d.ts",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/browser-playwright": "^5.0.4",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "exports": {
    "types": "./dist/binary_parser.d.ts",
    "default": "./dist/binary_parser.js"
  },
  "scripts": {
    "build": "tsc",
    "format": "prettier --list-different \"{lib,example,test,benchmark}/**/*.{ts,js}\"",
    "format:fix": "prettier --write \"{lib,example,test,benchmark}/**/*.{ts,js}\"",
    "test": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "prepare": "npm run build"
  },
  "files": [
    "dist",
    "lib"
  ],
  "keywords": [
    "binary",
    "parser",
    "decode",
    "unpack",
    "struct",
    "buffer",
    "bit"
  ],
  "author": {
    "name": "Keichi Takahashi",
    "email": "hello@keichi.dev",
    "url": "https://keichi.dev/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "http://github.com/keichi/binary-parser.git"
  },
  "bugs": "http://github.com/keichi/binary-parser/issues",
  "engines": {
    "node": ">=22.12"
  }
}
